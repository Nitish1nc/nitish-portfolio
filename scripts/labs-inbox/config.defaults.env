# Defaults for labs-inbox watcher.
# Copy to ~/.config/nitish-labs-inbox/config.env and override.

DOWNLOADS_DIR=/Users/nitishchauhan/Downloads
POLL_SECONDS=20
SETTLE_SECONDS=5
# Set to 0 while reviewing the pipeline; install-watcher will still run, but prefer pause-watcher.sh
AUTO_DEPLOY=0
NEXTCLOUD_INBOX=
# Optional Telegram (Hermes/bot). Leave blank to use macOS notifications only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
